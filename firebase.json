{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "functions/**",
      "**/.*",
      "**/node_modules/**",
      "**/*.md"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/hawaa-ops-7k11s",
        "function": { "functionId": "adminPortal", "region": "asia-south1" }
      },
      {
        "source": "/hawaa-ops-7k11s/**",
        "function": { "functionId": "adminPortal", "region": "asia-south1" }
      }
    ],
    "headers": [
      {
        "source": "/hawaa-ops-7k11s/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test"
      ]
    }
  ],
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
